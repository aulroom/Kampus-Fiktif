<% const title = 'Kelola Akun' %>
<%- include('../partials/header', { title }) %>

<h4>👤 Kelola Akun Pengguna</h4>

<% if (query && query.ok) { %>
  <div class="alert alert-success py-2">Berhasil.</div>
<% } %>
<% if (query && query.error) { %>
  <div class="alert alert-danger py-2"><%= query.error %></div>
<% } %>

<div class="card p-3 mb-4">
  <h6 class="mb-3">Tambah Akun Baru</h6>
  <form method="POST" action="/admin/users/create" class="row g-2">
    <div class="col-md-2">
      <input type="text" name="username" class="form-control form-control-sm" placeholder="Username" required />
    </div>
    <div class="col-md-2">
      <input type="text" name="password" class="form-control form-control-sm" placeholder="Password" required />
    </div>
    <div class="col-md-2">
      <select name="role" class="form-select form-select-sm" required>
        <option value="mahasiswa">Mahasiswa</option>
        <option value="dosen">Dosen</option>
        <option value="admin">Admin</option>
      </select>
    </div>
    <div class="col-md-3">
      <input type="text" name="nama_lengkap" class="form-control form-control-sm" placeholder="Nama Lengkap" required />
    </div>
    <div class="col-md-2">
      <input type="email" name="email" class="form-control form-control-sm" placeholder="Email (opsional)" />
    </div>
    <div class="col-md-1">
      <button class="btn btn-sm btn-primary w-100">Tambah</button>
    </div>
  </form>
</div>

<div class="card p-3">
  <table class="table table-sm align-middle">
    <thead>
      <tr><th>ID</th><th>Username</th><th>Nama</th><th>Role</th><th>Email</th><th>Dibuat</th><th></th></tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.id %></td>
          <td><%= u.username %></td>
          <td><%= u.nama_lengkap %></td>
          <td><span class="badge bg-secondary badge-role"><%= u.role %></span></td>
          <td class="small"><%= u.email || '-' %></td>
          <td class="small"><%= u.created_at %></td>
          <td class="text-nowrap">
            <button class="btn btn-sm btn-outline-secondary" type="button"
              data-bs-toggle="collapse" data-bs-target="#reset-<%= u.id %>">Reset PW</button>
            <% if (u.id !== user.id) { %>
              <form method="POST" action="/admin/users/<%= u.id %>/delete" class="d-inline"
                onsubmit="return confirm('Hapus akun <%= u.username %>?');">
                <button class="btn btn-sm btn-outline-danger">Hapus</button>
              </form>
            <% } %>
            <div class="collapse mt-2" id="reset-<%= u.id %>">
              <form method="POST" action="/admin/users/<%= u.id %>/reset-password" class="d-flex gap-1">
                <input type="text" name="new_password" class="form-control form-control-sm" placeholder="Password baru" required />
                <button class="btn btn-sm btn-warning text-nowrap">Set</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
