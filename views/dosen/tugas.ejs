<% const title = 'Kelola Tugas' %>
<%- include('../partials/header', { title }) %>

<h4>📝 Kelola Tugas</h4>

<% if (query && query.ok) { %>
  <div class="alert alert-success py-2">Tugas berhasil dibuat.</div>
<% } %>

<div class="card p-3 mb-4">
  <h6 class="mb-3">Buat Tugas Baru</h6>
  <form method="POST" action="/dosen/tugas/create" class="row g-2">
    <div class="col-md-4">
      <select name="mata_kuliah_id" class="form-select form-select-sm" required>
        <option value="">-- Pilih Mata Kuliah --</option>
        <% mataKuliah.forEach(mk => { %>
          <option value="<%= mk.id %>"><%= mk.kode %> - <%= mk.nama %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <input type="text" name="judul" class="form-control form-control-sm" placeholder="Judul tugas" required />
    </div>
    <div class="col-md-2">
      <input type="date" name="deadline" class="form-control form-control-sm" required />
    </div>
    <div class="col-md-2">
      <button class="btn btn-sm btn-primary w-100">Buat</button>
    </div>
    <div class="col-12">
      <textarea name="deskripsi" class="form-control form-control-sm" rows="2" placeholder="Deskripsi tugas"></textarea>
    </div>
  </form>
</div>

<% tugasList.forEach(t => { %>
  <div class="card p-3 mb-3">
    <h6><%= t.judul %> <span class="text-muted small">(<%= t.mk_nama %>)</span></h6>
    <p class="small"><%= t.deskripsi %></p>
    <p class="small text-danger">Deadline: <%= t.deadline %></p>

    <h6 class="small mt-3">Pengumpulan Mahasiswa:</h6>
    <% const subs = submissionsByTugas[t.id] %>
    <% if (subs.length === 0) { %>
      <p class="small text-muted">Belum ada mahasiswa yang mengumpulkan.</p>
    <% } else { %>
      <ul class="small mb-0">
        <% subs.forEach(s => { %>
          <li><%= s.nim %> - <%= s.nama_lengkap %>: <%= s.nama_file %> (<%= s.uploaded_at %>)</li>
        <% }) %>
      </ul>
    <% } %>
  </div>
<% }) %>

<%- include('../partials/footer') %>
