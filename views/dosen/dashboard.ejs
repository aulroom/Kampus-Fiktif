<% const title = 'Dashboard Dosen' %>
<%- include('../partials/header', { title }) %>

<h3>Selamat datang, <%= user.nama_lengkap %> 👋</h3>
<p class="text-muted">Dashboard dosen &mdash; Portal Kampus Fiktif.</p>

<div class="row g-3 mt-2">
  <div class="col-md-4">
    <div class="card p-3">
      <h6>📥 Input Nilai</h6>
      <p class="small text-muted">Berikan / ubah nilai mahasiswa untuk mata kuliah yang Anda ampu.</p>
      <a href="/dosen/nilai" class="btn btn-sm btn-primary">Input Nilai</a>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card p-3">
      <h6>📝 Tugas</h6>
      <p class="small text-muted">Buat tugas &amp; lihat pengumpulan mahasiswa.</p>
      <a href="/dosen/tugas" class="btn btn-sm btn-primary">Kelola Tugas</a>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card p-3">
      <h6>💬 Forum Diskusi</h6>
      <p class="small text-muted">Diskusi dengan mahasiswa.</p>
      <a href="/forum" class="btn btn-sm btn-primary">Buka Forum</a>
    </div>
  </div>
</div>

<h6 class="mt-4">Mata Kuliah yang Diampu</h6>
<ul>
  <% mataKuliah.forEach(mk => { %>
    <li><%= mk.kode %> - <%= mk.nama %> (<%= mk.sks %> SKS)</li>
  <% }) %>
</ul>

<%- include('../partials/footer') %>
