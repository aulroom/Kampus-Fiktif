<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Portal Kampus Fiktif' %></title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-indigo">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">🎓 Portal Kampus Fiktif</a>
      <div class="d-flex align-items-center gap-3">
        <% if (user) { %>
          <% if (user.role === 'mahasiswa') { %>
            <a class="nav-link d-inline text-white" href="/mahasiswa/dashboard">Dashboard</a>
            <a class="nav-link d-inline text-white" href="/mahasiswa/nilai">Nilai</a>
            <a class="nav-link d-inline text-white" href="/mahasiswa/tugas">Tugas</a>
          <% } else if (user.role === 'dosen') { %>
            <a class="nav-link d-inline text-white" href="/dosen/dashboard">Dashboard</a>
            <a class="nav-link d-inline text-white" href="/dosen/nilai">Input Nilai</a>
            <a class="nav-link d-inline text-white" href="/dosen/tugas">Tugas</a>
          <% } else if (user.role === 'admin') { %>
            <a class="nav-link d-inline text-white" href="/admin/dashboard">Dashboard</a>
            <a class="nav-link d-inline text-white" href="/admin/users">Kelola Akun</a>
          <% } %>
          <a class="nav-link d-inline text-white" href="/forum">Forum</a>
          <span class="text-white-50 small">| <%= user.nama_lengkap %> (<%= user.role %>)</span>
          <a class="btn btn-sm btn-outline-light" href="/logout">Keluar</a>
        <% } %>
      </div>
    </div>
  </nav>
  <main class="container py-4">
