<% const title = 'Tugas Saya' %>
<%- include('../partials/header', { title }) %>

<h4>📝 Daftar Tugas</h4>

<% if (query && query.ok) { %>
  <div class="alert alert-success py-2">File berhasil diunggah.</div>
<% } %>
<% if (query && query.error) { %>
  <div class="alert alert-danger py-2"><%= query.error %></div>
<% } %>

<div class="row g-3 mt-1">
  <% tugasList.forEach(t => { %>
    <div class="col-md-6">
      <div class="card p-3 h-100">
        <h6><%= t.judul %></h6>
        <p class="small text-muted mb-1"><%= t.kode %> - <%= t.mk_nama %></p>
        <p class="small"><%= t.deskripsi %></p>
        <p class="small text-danger mb-2">Deadline: <%= t.deadline %></p>

        <% const sub = submittedMap[t.id] %>
        <% if (sub) { %>
          <div class="alert alert-success py-1 small mb-2">
            Sudah dikumpulkan: <%= sub.nama_file %> (<%= sub.uploaded_at %>)
          </div>
        <% } %>

        <form method="POST" action="/mahasiswa/tugas/<%= t.id %>/upload" enctype="multipart/form-data" class="d-flex gap-2">
          <input type="file" name="file_tugas" class="form-control form-control-sm" required />
          <button class="btn btn-sm btn-primary text-nowrap"><%= sub ? 'Ganti File' : 'Unggah' %></button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

<%- include('../partials/footer') %>
